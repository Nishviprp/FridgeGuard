# ────────────────────────────────────────────────────────────────
# Supabase  →  https://supabase.com/dashboard/project/_/settings/api
# ────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...your-anon-key

# Service role key — NEVER expose to the browser.
# Used by scheduled Netlify functions to query across all users (bypasses RLS).
# Found at: Supabase → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...your-service-role-key

# ────────────────────────────────────────────────────────────────
# Claude API (Anthropic)  →  https://console.anthropic.com/
# ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ────────────────────────────────────────────────────────────────
# Email notifications via Resend  →  https://resend.com
# Free tier: 3000 emails/month, no credit card required
# ────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxx...
RESEND_FROM_EMAIL=FridgeGuard <noreply@yourdomain.com>

# Public URL of your deployed app (used in email links + push redirect)
APP_URL=https://fridgeguard.netlify.app

# ────────────────────────────────────────────────────────────────
# Web Push / VAPID keys
# Generate once with:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY is used server-side only (served via /api/push-subscription)
# ────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@yourapp.com

# ────────────────────────────────────────────────────────────────
# Test notifications endpoint (dev/staging only)
# Set to 'true' to enable GET /api/test-notifications on deployed envs
# ────────────────────────────────────────────────────────────────
ALLOW_TEST_NOTIFICATIONS=false
